---
const timeline = [
  { era: 'Эпоха Титанов', text: 'Титаны упорядочили Азерот и оставили хранителей. Древние Боги остались в глубинах мира.' },
  { era: 'Раскол', text: 'Война Древних и взрыв Колодца Вечности раскололи единый Калимдор на континенты.' },
  { era: 'Третья Война', text: 'Падение Лордерона, возвращение Легиона и рождение новой Орды изменили судьбу народов.' },
  { era: 'Война за Азерот', text: 'Орда и Альянс снова сходятся в битве, а древние силы просыпаются под поверхностью мира.' },
];
---
<section class="section" id="lore">
  <div class="container lore-layout">
    <div class="lore-intro reveal">
      <span class="eyebrow">Архив хроник</span>
      <h2>История, написанная войнами и надеждой</h2>
      <p>Азерот помнит королевства, что пали, героев, что не вернулись, и союзы, которые пережили века. Вот несколько глав его великой саги.</p>
      <a class="lore-link" href="#races">Встретить народы Азерота <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="lore-timeline">
      {timeline.map((item, i) => (
        <li class="lore-event reveal">
          <span class="lore-event__number">0{i + 1}</span>
          <div><h3>{item.era}</h3><p>{item.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
