---
/** Supplemental original landscape SVGs used where game screenshots are not required. */
interface Props { variant?: string; label?: string; }
const { variant = 'banner', label } = Astro.props as Props;
const uid = `a-${variant}-${Math.random().toString(36).slice(2, 7)}`;
---
<svg class:list={['artwork', `artwork--${variant}`]} viewBox="0 0 600 380" role="img" aria-label={label ?? 'Пейзаж Азерота'}>
  <defs>
    <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={variant === 'orc' ? '#51372f' : '#273c49'} /><stop offset=".56" stop-color="#26352c" /><stop offset="1" stop-color="#11170f" /></linearGradient>
    <linearGradient id={`${uid}-land`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5c6444" /><stop offset="1" stop-color="#1a2118" /></linearGradient>
    <radialGradient id={`${uid}-sun`}><stop stop-color="#f4d88b" stop-opacity=".9" /><stop offset="1" stop-color="#e7ad57" stop-opacity="0" /></radialGradient>
  </defs>
  <rect width="600" height="380" fill={`url(#${uid}-sky)`} />
  <circle cx="420" cy="110" r="90" fill={`url(#${uid}-sun)`} />
  <circle cx="420" cy="110" r="29" fill="#e7d099" opacity=".8" />
  <g fill="#e9dcae" opacity=".7"><circle cx="62" cy="55" r="2"/><circle cx="130" cy="93" r="1.5"/><circle cx="260" cy="46" r="1.7"/><circle cx="530" cy="58" r="1.4"/></g>
  <path d="M0 255 110 147l62 69 88-108 90 112 91-95 159 127v128H0z" fill="#303a32" />
  <path d="m0 294 119-94 74 67 93-73 107 90 108-91 99 95v92H0z" fill="#202a20" />
  <path d="M0 315q90-36 183 0t183 0 234 0v65H0z" fill="url(#${uid}-land)" />
  <g fill="#151b15"><path d="m80 327 24-84 24 84zM123 328l31-111 32 111zM470 332l22-91 24 91zM513 331l32-120 33 120z" /></g>
  <path d="M0 364q130-32 240 2t360-4v18H0z" fill="#121710" />
</svg>
<style>
.artwork { width:100%; height:auto; display:block; border-radius:var(--radius-sm); }
</style>
