---
const cells = [
  { key: 'days', label: 'дней' },
  { key: 'hours', label: 'часов' },
  { key: 'minutes', label: 'минут' },
  { key: 'seconds', label: 'секунд' },
];
---

<section class="section" id="event" style="padding-top:0">
  <div class="container">
    <div class="panel event reveal" data-countdown>
      <div>
        <span class="eyebrow">Событие недели</span>
        <h3>Большой рейд-найт: суббота, 20:00 МСК</h3>
        <p>
          Собираем составы во все рейды классики: от подземелий до рейдовых боссов. Новичкам —
          отдельные пати с наставниками и разбором механик.
        </p>
      </div>

      <div class="countdown" aria-label="До начала события">
        {
          cells.map((cell) => (
            <div class="countdown__cell">
              <b data-cd={cell.key}>—</b>
              <span>{cell.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
