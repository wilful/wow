---
const classes = [
  {
    name: 'Воин',
    short: 'Во',
    tagline: 'Танк или боец ближнего боя',
    roles: ['Танк', 'Ближний бой'],
    text: 'Стойкий и прямолинейный класс: держит удар щитом или ломает противника двумя оружиями. Идеален, если нравится идти в бой первым и командовать строем.',
    mastery: 55,
    demand: 82,
    pvp: 70,
  },
  {
    name: 'Паладин',
    short: 'Па',
    tagline: 'Свет, щит и поддержка группы',
    roles: ['Танк', 'Хил', 'Ближний бой'],
    text: 'Одна из самых гибких профессий: может лечить, танковать и бить. Отличный выбор, если хочется приносить пользу всей группе.',
    mastery: 60,
    demand: 88,
    pvp: 76,
  },
  {
    name: 'Охотник',
    short: 'Ох',
    tagline: 'Дальний урон и верный питомец',
    roles: ['Дальний бой'],
    text: 'Простой вход и большой потолок: питомец, ловушки и точные выстрелы. Хороший старт для новичка, но в умелых руках — гроза арен.',
    mastery: 40,
    demand: 74,
    pvp: 66,
  },
  {
    name: 'Разбойник',
    short: 'Ра',
    tagline: 'Яд, клинок и удар из тени',
    roles: ['Ближний бой'],
    text: 'Мастер скрытности и контроля. Требует понимания таймингов, зато награждает за аккуратность в PvP как никто другой.',
    mastery: 72,
    demand: 58,
    pvp: 88,
  },
  {
    name: 'Жрец',
    short: 'Жр',
    tagline: 'Лучшие лекари Азерота',
    roles: ['Хил', 'Дальний бой'],
    text: 'Сердце любого рейда: щиты, массовое исцеление и «второе дыхание» для пати. Если нравится спасать команду — это он.',
    mastery: 64,
    demand: 92,
    pvp: 54,
  },
  {
    name: 'Шаман',
    short: 'Ша',
    tagline: 'Тотемы, стихии и бурст',
    roles: ['Хил', 'Дальний бой', 'Ближний бой'],
    text: 'Универсальный класс с тотемами и мощными мгновенными заклинаниями. Хорош и в рейде, и в одиночной игре.',
    mastery: 74,
    demand: 80,
    pvp: 62,
  },
  {
    name: 'Маг',
    short: 'Ма',
    tagline: 'Контроль и стихийный урон',
    roles: ['Дальний бой'],
    text: 'Телепорты, еда и заклинания с огромным уроном. Класс про позицию: стоит ошибиться с дистанцией — и жить останется три секунды.',
    mastery: 70,
    demand: 86,
    pvp: 78,
  },
  {
    name: 'Чернокнижник',
    short: 'Чн',
    tagline: 'Демоны, порча и стойкость',
    roles: ['Дальний бой'],
    text: 'Один из самых выносливых заклинателей: демон-помощник, порча и страх. Требует много внимания к ротации и ресурсам.',
    mastery: 80,
    demand: 70,
    pvp: 64,
  },
  {
    name: 'Друид',
    short: 'Др',
    tagline: 'Меняет форму — меняет роль',
    roles: ['Танк', 'Хил', 'Ближний бой', 'Дальний бой'],
    text: 'Четыре формы — четыре разные игры: медведь танкует, дерево лечит, кот и сова наносят урон. Самый многогранный класс.',
    mastery: 86,
    demand: 76,
    pvp: 72,
  },
];

const first = classes[0];
---

<section class="section" id="classes">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow">Выбор класса</span>
      <h2>Кем будешь играть?</h2>
      <p>Нажмите на класс — карточка ниже расскажет, чем он живет в рейдах и на арене.</p>
    </div>

    <div class="classes__picks" role="tablist" aria-label="Классы">
      {
        classes.map((item) => (
          <button
            class="class-pick"
            type="button"
            role="tab"
            data-class-pick
            aria-selected="false"
            data-name={item.name}
            data-tagline={item.tagline}
            data-roles={item.roles.join(',')}
            data-text={item.text}
            data-mastery={item.mastery}
            data-demand={item.demand}
            data-pvp={item.pvp}
          >
            <span class="class-pick__crest" aria-hidden="true">{item.short}</span>
            <span>{item.name}</span>
          </button>
        ))
      }
    </div>

    <div class="panel class-detail reveal" data-class-detail aria-live="polite">
      <div class="class-detail__head">
        <h3 data-class-title>{first.name}</h3>
        <span style="color:var(--muted);font-size:.92rem" data-class-tagline>{first.tagline}</span>
      </div>

      <div class="class-detail__roles" data-class-roles>
        {first.roles.map((role) => <span class="chip">{role}</span>)}
      </div>

      <p style="margin-top:1rem" data-class-text>{first.text}</p>

      <div class="meter">
        <div class="meter__row" data-meter="mastery">
          <span>Освоение</span>
          <span class="meter__bar" style={`--v:${first.mastery}`}><span></span></span>
          <b data-meter-value>{first.mastery}</b>
        </div>
        <div class="meter__row" data-meter="demand">
          <span>Спрос в рейдах</span>
          <span class="meter__bar" style={`--v:${first.demand}`}><span></span></span>
          <b data-meter-value>{first.demand}</b>
        </div>
        <div class="meter__row" data-meter="pvp">
          <span>Сила в PvP</span>
          <span class="meter__bar" style={`--v:${first.pvp}`}><span></span></span>
          <b data-meter-value>{first.pvp}</b>
        </div>
      </div>
    </div>
  </div>
</section>
