---
import Artwork from './Artwork.astro';
import { races } from '../data/races';

const base = import.meta.env.BASE_URL;
---

<section class="section section--alt" id="races">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow">Расы Азерота</span>
      <h2>За кого я играю</h2>
      <p>
        Каждая раса — отдельный характер и отдельные впечатления. Откройте карточку, чтобы прочитать
        подробное описание и найти записи журнала, связанные с этой расой.
      </p>
    </div>

    <div class="races">
      {
        races.map((race) => (
          <article class="panel panel--hover race reveal">
            <a class="race__link" href={`${base}races/${race.slug}/`}>
              <div class="race__art">
                <Artwork variant={race.art} label={`Портрет: ${race.name}`} />
              </div>
              <div class="race__body">
                <span class="race__faction">{race.factionLabel}</span>
                <h3>{race.name}</h3>
                <p>{race.card}</p>
                <span class="race__more">Подробнее →</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
