---
import { races } from '../data/races';

const base = import.meta.env.BASE_URL;
---

<section class="section section--alt" id="races">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow">Выбери сторону</span>
      <h2>Народы и их судьбы</h2>
      <p>
        У каждого народа свой дом, своя культура и своя история. Загляни в портреты, чтобы найти
        тех, чья дорога отзывается именно тебе.
      </p>
    </div>

    <div class="races">
      {
        races.map((race) => (
          <article class="panel panel--hover race reveal">
            <a class="race__link" href={`${base}races/${race.slug}/`}>
              <div class="race__art">
                <img src={race.image} alt={`Портрет персонажа: ${race.name}`} loading="lazy" />
                <span class="race__crest" aria-hidden="true">{race.faction === 'alliance' ? '✦' : '⚔'}</span>
              </div>
              <div class="race__body">
                <span class="race__faction">{race.factionLabel}</span>
                <h3>{race.name}</h3>
                <p>{race.card}</p>
                <span class="race__more">Подробнее →</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
