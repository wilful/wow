---
const stats = [
  { value: '24/7', label: 'сервер онлайн' },
  { value: '5 400+', label: 'игроков в сообществе' },
  { value: '3', label: 'реалма на выбор' },
  { value: '2019', label: 'год запуска проекта' },
];

const facts = [
  ['Версия', 'Classic 1.12.1'],
  ['Рейты', 'x1 (без доната)'],
  ['Язык', 'Русский'],
  ['Пинг из РФ', '~35 мс'],
];
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true"></div>

  <svg
    class="hero__runes"
    viewBox="0 0 1440 600"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <g fill="#f5e3ad">
      <circle cx="140" cy="80" r="1.6"></circle>
      <circle cx="330" cy="150" r="1.3"></circle>
      <circle cx="520" cy="60" r="1.8"></circle>
      <circle cx="880" cy="120" r="1.4"></circle>
      <circle cx="1180" cy="70" r="1.7"></circle>
      <circle cx="1340" cy="200" r="1.3"></circle>
      <circle cx="760" cy="220" r="1.2"></circle>
      <circle cx="240" cy="320" r="1.4"></circle>
      <circle cx="1040" cy="330" r="1.2"></circle>
    </g>
    <g
      fill="none"
      stroke="#c8b4ff"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.75"
    >
      <path d="M200 470v-30M200 440l14 9M200 455l14 9" transform="translate(0,40)"></path>
      <path d="M420 500v-30M420 470l14 9M420 485l14 9"></path>
      <path d="M900 500v-30M900 470l14 9M900 485l14 9"></path>
      <path d="M1260 480v-30M1260 450l14 9M1260 465l14 9"></path>
    </g>
  </svg>

  <svg class="hero__moon" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="hero-halo">
        <stop offset="0" stop-color="#f5e3ad" stop-opacity="0.5"></stop>
        <stop offset="1" stop-color="#f5e3ad" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle cx="60" cy="60" r="58" fill="url(#hero-halo)"></circle>
    <circle cx="60" cy="60" r="33" fill="#f5e3ad"></circle>
    <circle cx="73" cy="49" r="29" fill="#0a0d22" opacity="0.62"></circle>
  </svg>

  <svg
    class="hero__mountains"
    viewBox="0 0 1440 320"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="m1" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#232a55"></stop>
        <stop offset="1" stop-color="#05060e"></stop>
      </linearGradient>
      <linearGradient id="m2" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#161d3d"></stop>
        <stop offset="1" stop-color="#05060e"></stop>
      </linearGradient>
    </defs>
    <path
      d="M0 250l150-120 120 96 130-140 160 150 140-90 170 120 160-140 190 150 220-110v304H0z"
      fill="url(#m1)"></path>
    <path d="M0 300l180-90 140 70 170-100 180 110 190-80 200 90 180-60v200H0z" fill="url(#m2)"></path>
  </svg>

  <canvas id="embers" aria-hidden="true"></canvas>

  <div class="container hero__inner">
    <div>
      <h1 class="hero__title"><span>Русскоязычный мир</span>WoW Forever</h1>
      <p class="hero__lead">
        Классический Азерот, живые рейды и гильдии, где говорят по-русски. Без доната, без
        обещаний «завтра» — заходи и играй сегодня.
      </p>

      <div class="btn-row">
        <a class="btn btn--gold" href="#start">Начать играть</a>
        <a class="btn btn--ghost" href="#news">Новости проекта</a>
      </div>

      <div class="hero__stats">
        {
          stats.map((stat) => (
            <div class="hero__stat">
              <b>{stat.value}</b>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <aside class="panel hero__card" aria-label="Кратко о проекте">
      <h3>Сводка</h3>
      <dl>
        {
          facts.map(([key, value]) => (
            <>
              <dt>{key}</dt>
              <dd>{value}</dd>
            </>
          ))
        }
      </dl>
      <p class="note">
        Данные в этой карточке — заполнитель превью. Подключите реальные значения сервера позже.
      </p>
    </aside>
  </div>
</section>
