---
import Artwork from './Artwork.astro';
const base = import.meta.env.BASE_URL;

const stats = [
  ['Патч', '12.0'],
  ['Первый вечер', '24 октября'],
  ['Записей', 'пополняется'],
  ['Галерея', 'свои скрины'],
];
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true"></div>
  <svg class="hero__moon" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="hero-halo">
        <stop offset="0" stop-color="#f5e3ad" stop-opacity="0.5" />
        <stop offset="1" stop-color="#f5e3ad" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="60" cy="60" r="58" fill="url(#hero-halo)" />
    <circle cx="60" cy="60" r="33" fill="#f5e3ad" />
    <circle cx="73" cy="49" r="29" fill="#0a0d22" opacity="0.62" />
  </svg>
  <svg class="hero__mountains" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="m1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#232a55" /><stop offset="1" stop-color="#05060e" /></linearGradient>
      <linearGradient id="m2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#161d3d" /><stop offset="1" stop-color="#05060e" /></linearGradient>
    </defs>
    <path d="M0 250l150-120 120 96 130-140 160 150 140-90 170 120 160-140 190 150 220-110v304H0z" fill="url(#m1)" />
    <path d="M0 300l180-90 140 70 170-100 180 110 190-80 200 90 180-60v200H0z" fill="url(#m2)" />
  </svg>

  <div class="container hero__inner">
    <div>
      <h1 class="hero__title"><span>Дневник игрока</span>WoW Forever</h1>
      <p class="hero__lead">
        Мой личный журнал о новом патче: впечатления, скриншоты, любимые расы и всё, что цепляет в
        Азероте через много лет после первой ночи в игре.
      </p>
      <div class="btn-row">
        <a class="btn btn--gold" href="#journal">Читать записи</a>
        <a class="btn btn--ghost" href="#gallery">Смотреть галерею</a>
      </div>
      <dl class="hero__stats">
        {stats.map(([k, v]) => (<div class="hero__stat"><dt>{v}</dt><dd>{k}</dd></div>))}
      </dl>
    </div>

    <aside class="panel art hero__art" aria-label="Иллюстрация журнала">
      <Artwork variant="nightelf" label="Ночная эльфийка под луной" />
      <p class="art__caption">«Возвращаться в Азерот — это как читать старую любимую книгу»</p>
      <a class="hero__art-link" href={`${base}posts/pervyy-vecher-v-patche/`}>Первая запись журнала →</a>
    </aside>
  </div>
</section>
