---
import Artwork from './Artwork.astro';
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true"></div>
  <svg class="hero__moon" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="hero-halo">
        <stop offset="0" stop-color="#f5e3ad" stop-opacity="0.5" />
        <stop offset="1" stop-color="#f5e3ad" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="60" cy="60" r="58" fill="url(#hero-halo)" />
    <circle cx="60" cy="60" r="33" fill="#f5e3ad" />
    <circle cx="73" cy="49" r="29" fill="#0a0d22" opacity="0.62" />
  </svg>
  <svg class="hero__mountains" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="m1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#232a55" /><stop offset="1" stop-color="#05060e" /></linearGradient>
      <linearGradient id="m2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#161d3d" /><stop offset="1" stop-color="#05060e" /></linearGradient>
    </defs>
    <path d="M0 250l150-120 120 96 130-140 160 150 140-90 170 120 160-140 190 150 220-110v304H0z" fill="url(#m1)" />
    <path d="M0 300l180-90 140 70 170-100 180 110 190-80 200 90 180-60v200H0z" fill="url(#m2)" />
  </svg>

  <div class="container hero__inner">
    <div>
      <p class="hero__kicker">Фанатский портал · мир Азерота</p>
      <h1 class="hero__title"><span>Твоя история ждёт</span>Мир, в который<br />хочется вернуться</h1>
      <p class="hero__lead">
        Путеводитель для тех, кто любит World of Warcraft: герои, легенды, красивые места и истории
        из наших приключений. Выбирай свой путь — за Орду или Альянс.
      </p>
      <div class="btn-row">
        <a class="btn btn--gold" href="#journal">В путь по Азероту <span aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href="#lore">Узнать легенды</a>
      </div>
      <div class="hero__signature"><span class="hero__sig-mark">✦</span><span><b>Для своих</b><small>Фанатский взгляд на любимую вселенную</small></span></div>
    </div>

    <aside class="panel art hero__art" aria-label="Портрет героя Азерота">
      <div class="hero__portrait">
        <img src="https://wow.zamimg.com/images/wow/icons/large/achievement_character_nightelf_male.jpg" alt="Ночной эльф, герой Азерота" />
        <span class="hero__portrait-tag">Путеводитель по Азероту</span>
      </div>
      <div class="hero__factions"><span>Альянс</span><i>✦</i><span>Орда</span></div>
      <p class="art__caption">Одна вселенная. Тысячи историй.</p>
      <a class="hero__art-link" href={`${base}#races`}>Знакомься с народами →</a>
    </aside>
  </div>
</section>
