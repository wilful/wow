---
import { shots } from '../data/gallery';
---

<section class="section" id="gallery">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow">Альбом путешественника</span>
      <h2>Альбом странника</h2>
      <p>Кадры из мира, который звал за следующий холм. Собери свою коллекцию воспоминаний.</p>
    </div>

    <div class="gallery">
      {
        shots.map((shot) => (
          <figure class="shot reveal">
            <div class="shot__frame">
              <img src={shot.src} alt={shot.caption} loading="lazy" />
              <span class="shot__place">{shot.place}</span>
            </div>
            <figcaption>{shot.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
