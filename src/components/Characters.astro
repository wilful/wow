---
import { races } from '../data/races';

const classes = [
  { name: 'Воин', role: 'Фронт боя', slug: 'warrior', race: 'humans', color: '#a94f3f', races: ['Люди', 'Орки', 'Дворфы'] },
  { name: 'Паладин', role: 'Свет и защита', slug: 'paladin', race: 'humans', color: '#c6a35d', races: ['Люди', 'Дворфы', 'Дренеи', 'Кровавые эльфы'] },
  { name: 'Охотник', role: 'Следопыт', slug: 'hunter', race: 'dwarves', color: '#78935b', races: ['Ночные эльфы', 'Орки', 'Таурены', 'Тролли'] },
  { name: 'Разбойник', role: 'Тень и сталь', slug: 'rogue', race: 'undead', color: '#9c9b68', races: ['Люди', 'Гномы', 'Нежить', 'Тролли'] },
  { name: 'Жрец', role: 'Исцеление и вера', slug: 'priest', race: 'draenei', color: '#d4c9b1', races: ['Люди', 'Ночные эльфы', 'Тролли', 'Дренеи'] },
  { name: 'Шаман', role: 'Голос стихий', slug: 'shaman', race: 'orcs', color: '#6289a0', races: ['Орки', 'Таурены', 'Тролли', 'Дренеи'] },
  { name: 'Маг', role: 'Тайные знания', slug: 'mage', race: 'gnomes', color: '#7289bb', races: ['Люди', 'Гномы', 'Тролли', 'Кровавые эльфы'] },
  { name: 'Чернокнижник', role: 'Запретная магия', slug: 'warlock', race: 'orcs', color: '#a85a60', races: ['Люди', 'Гномы', 'Орки', 'Нежить'] },
  { name: 'Друид', role: 'Сила природы', slug: 'druid', race: 'night-elves', color: '#639369', races: ['Ночные эльфы', 'Таурены'] },
];
---
<section class="section section--alt" id="characters">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow">Пути героя</span>
      <h2>Классы Азерота</h2>
      <p>От стального щита до драконьего пламени — выбери путь, который станет твоей легендой.</p>
    </div>
    <div class="class-grid">
      {classes.map((hero, i) => {
        const race = races.find((candidate) => candidate.slug === hero.race) ?? races[i % races.length];
        return (
          <article class="class-card panel panel--hover reveal" style={`--class-accent:${hero.color}`}>
            <div class="class-card__portrait">
              <img src={race.image} alt={`${race.name} — ${hero.name}`} loading="lazy" />
              <img class="class-card__icon" src={`https://wow.zamimg.com/images/wow/icons/large/classicon_${hero.slug}.jpg`} alt="" loading="lazy" />
              <span class="class-card__number">0{i + 1}</span>
            </div>
            <div class="class-card__body">
              <p class="class-card__role">{hero.role}</p>
              <h3>{hero.name}</h3>
              <p class="class-card__races">{hero.races.join(' · ')}</p>
            </div>
          </article>
        );
      })}
    </div>
    <p class="class-note">Классы и доступные расы зависят от дополнения и версии игры.</p>
  </div>
</section>
