---
import Artwork from './Artwork.astro';

const notes = [
  ['Кто я', 'Играю в World of Warcraft с классики. Веду этот дневник для себя — и для тех, кому интересно читать честные впечатления, а не обзоры по пресс-релизам.'],
  ['О чём сайт', 'Про новый патч: что понравилось, что нет, как ощущается игра через год паузы. Плюс галерея кадров и короткие заметки.'],
  ['Как часто', 'Одна-две записи в неделю. Если игра не заходит — честно напишу и об этом.'],
];
---

<section class="section" id="about">
  <div class="container">
    <div class="about">
      <div class="panel art reveal">
        <Artwork />
        <p class="art__caption">Азерот, каким я его вижу: ночь, горы и немного магии</p>
      </div>

      <div class="reveal">
        <span class="eyebrow">О сайте</span>
        <h2>Дневник игрока, а не новостной сайт</h2>
        <p>
          WoW Forever — это мой личный журнал о новой игре и новом патче. Здесь нет новостей,
          рейтингов и «серверных» обещаний: только то, что я сам увидел и почувствовал.
        </p>
        <dl class="about__list">
          {notes.map(([key, value]) => (<div><dt>{key}</dt><dd>{value}</dd></div>))}
        </dl>
      </div>
    </div>
  </div>
</section>
