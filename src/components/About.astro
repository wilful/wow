---
import Artwork from './Artwork.astro';

const notes = [
  ['Хроники', 'Истории народов, древних сил и мест, которые делают Азерот живым.'],
  ['Приключения', 'Путевые заметки, любимые персонажи и впечатления игроков.'],
  ['Сообщество', 'Фанатский проект для всех, кому хочется разделить любовь к этой вселенной.'],
];
---
<section class="section" id="about">
  <div class="container">
    <div class="about">
      <div class="panel art reveal">
        <Artwork />
        <p class="art__caption">Азерот — мир, где за горизонтом всегда ждёт новая история</p>
      </div>
      <div class="reveal">
        <span class="eyebrow">У костра после похода</span>
        <h2>Собрались здесь, потому что любим этот мир</h2>
        <p>WoW Forever — фанатский путеводитель по Азероту. Здесь мы вспоминаем легенды, знакомимся с народами и делимся историями — большими и совсем маленькими.</p>
        <dl class="about__list">
          {notes.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
    </div>
  </div>
</section>
