---
import Artwork from './Artwork.astro';

const notes = [
  ['Легенды', 'Истории народов, древних сил и мест, которые делают Азерот живым.'],
  ['Приключения', 'Путевые заметки, любимые персонажи и впечатления игроков.'],
  ['Сообщество', 'Фанатский проект для всех, кому хочется разделить любовь к этой вселенной.'],
];
---

<section class="section" id="about">
  <div class="container">
    <div class="about">
      <div class="panel art reveal">
        <Artwork />
        <p class="art__caption">Азерот, каким я его вижу: ночь, горы и немного магии</p>
      </div>

      <div class="reveal">
        <span class="eyebrow">Наш лагерь у костра</span>
        <h2>Место для тех, кто любит Азерот</h2>
        <p>
          WoW Forever — фанатский уголок, собранный из любви к игре. Здесь мы говорим о мире, героях
          и моментах, которые хочется пережить снова — без спешки и без правильных ответов.
        </p>
        <dl class="about__list">
          {notes.map(([key, value]) => (<div><dt>{key}</dt><dd>{value}</dd></div>))}
        </dl>
      </div>
    </div>
  </div>
</section>
