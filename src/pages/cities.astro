      <div class="shell">
        <div class="foot-grid">
          <div class="foot-brand">
            <svg viewBox="0 0 48 56" aria-hidden="true">
              <defs>
                <linearGradient id="crestF" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#f3dd93" />
                  <stop offset="0.5" stop-color="#d4af37" />
                  <stop offset="1" stop-color="#8a6a22" />
                </linearGradient>
              </defs>
              <path d="M24 2 44 9v17c0 14-8.6 23.4-20 28C12.6 49.4 4 40 4 26V9Z" fill="#7e1a15" stroke="url(#crestF)" stroke-width="3" />
              <text x="24" y="36" text-anchor="middle" font-family="Cinzel Decorative, serif" font-size="24" font-weight="700" fill="url(#crestF)">D</text>
            </svg>
            <div>
              <b>DUROTAR</b><br />
              <span>гильдия World of Warcraft: Forever</span>
            </div>
          </div>

          <nav class="foot-links" aria-label="Ссылки подвала">
            <a href={base}>Главная</a>
            <a href={`${base}#about`}>О нас</a>
            <a href={`${base}#recruit`}>Набор</a>
            <a href={`${base}#contacts`}>Discord</a>
          </nav>
        </div>

        <p class="foot-note">
          © {new Date().getFullYear()} Гильдия Durotar. Сайт посвящён игре World of Warcraft:
          Forever; World of Warcraft и Warcraft® — товарные знаки Blizzard Entertainment.
          Проект любительский и не связан с Blizzard. Скриншоты городов: <a
            href="https://warcraft.wiki.gg/"
            rel="noopener">warcraft.wiki.gg</a>.
        </p>
      </div>
    </footer>

    <script>
      // Шапка мягко отбрасывает тень, когда страница прокручена.
      const topbar = document.querySelector<HTMLElement>('.topbar');
      if (topbar) {
        const onScroll = () => topbar.classList.toggle('scrolled', window.scrollY > 10);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
