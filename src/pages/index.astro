    <!-- ══ набор ══ -->
    <section class="recruit" id="recruit">
      <img
        class="recruit-bg"
        src={lava.src}
        alt={lava.alt}
        loading="lazy"
        decoding="async"
      />
      <div class="recruit-inner">
        <div class="sec-title" style="margin-bottom: 0">
          <h2 class="gold-text">Нам нужны герои</h2>
          <svg class="fleuron" viewBox="0 0 320 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M0 12h110" stroke-width="1.2" opacity="0.7" />
            <path d="M210 12h110" stroke-width="1.2" opacity="0.7" />
            <path d="M160 4c-14 0-22 4-30 8 8 4 16 8 30 8s22-4 30-8c-8-4-16-8-30-8z" stroke-width="1.4" />
            <circle cx="160" cy="12" r="3" fill="currentColor" stroke="none" />
            <path d="M124 12c8-6 14-8 20-8M196 12c-8-6-14-8-20-8" stroke-width="1.1" opacity="0.8" />
            <path d="M124 12c8 6 14 8 20 8M196 12c-8 6-14 8-20 8" stroke-width="1.1" opacity="0.8" />
          </svg>
        </div>
        <p>
          Открытый набор в гильдию. Ищем танков, хилов и дд — и просто хороших людей, которым
          важно, с кем они играют. Присоединяйся: познакомимся и покажем, как всё устроено.
        </p>
        <div class="roles">
          {roles.map((r) => <span class="role">{r}</span>)}
        </div>
        <a class="btn btn-gold" href={`${base}join/`}>Оставить заявку</a>
      </div>
    </section>

