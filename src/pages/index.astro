    <script>
      // Анимация героя: лёгкий наклон картинки при наведении мыши
      // и погода по локальным часам — час дождя в каждом 4-часовом блоке.
      const heroEl = document.querySelector<HTMLElement>('.hero');
      const bgEl = document.querySelector<HTMLElement>('.hero-bg');
      const rainEl = document.querySelector<HTMLCanvasElement>('.hero-rain');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (heroEl && bgEl && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
        heroEl.addEventListener('pointermove', (e) => {
          const r = heroEl.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          bgEl.style.setProperty('--tilt-x', (x * 7).toFixed(2) + 'deg');
          bgEl.style.setProperty('--tilt-y', (-y * 5).toFixed(2) + 'deg');
        });
        heroEl.addEventListener('pointerleave', () => {
          bgEl.style.setProperty('--tilt-x', '0deg');
          bgEl.style.setProperty('--tilt-y', '0deg');
        });
      }

      const isRainTime = () => new Date().getHours() % 4 === 0;

      if (heroEl && rainEl) {
        const ctx = rainEl.getContext('2d');

        if (ctx) {
          let w = 0;
          let h = 0;
          let raf = 0;
          let drops: { x: number; y: number; len: number; v: number; a: number }[] = [];

          const resize = () => {
            const r = heroEl.getBoundingClientRect();
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            w = Math.max(1, Math.round(r.width));
            h = Math.max(1, Math.round(r.height));
            rainEl.width = Math.round(w * dpr);
            rainEl.height = Math.round(h * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            drops = Array.from({ length: Math.max(40, Math.round(w / 6)) }, () => ({
              x: Math.random() * w,
              y: Math.random() * h,
              len: 12 + Math.random() * 22,
              v: 6 + Math.random() * 9,
              a: 0.15 + Math.random() * 0.35,
            }));
          };

          const frame = () => {
            ctx.clearRect(0, 0, w, h);
            ctx.lineWidth = 1.1;
            ctx.lineCap = 'round';
            for (const d of drops) {
              ctx.strokeStyle = `rgba(196, 214, 235, ${d.a})`;
              ctx.beginPath();
              ctx.moveTo(d.x, d.y);
              ctx.lineTo(d.x - 2, d.y + d.len);
              ctx.stroke();
              d.y += d.v;
              d.x -= 0.6;
              if (d.y > h) {
                d.y = -d.len;
                d.x = Math.random() * w;
              }
            }
            raf = requestAnimationFrame(frame);
          };

          const apply = () => {
            const rainy = isRainTime();
            heroEl.classList.toggle('is-raining', rainy);
            if (rainy && !reduceMotion && !raf) {
              resize();
              raf = requestAnimationFrame(frame);
            } else if ((!rainy || reduceMotion) && raf) {
              cancelAnimationFrame(raf);
              raf = 0;
              ctx.clearRect(0, 0, w, h);
            }
          };

          window.addEventListener('resize', () => {
            if (raf) resize();
          });
          document.addEventListener('visibilitychange', apply);
          window.setInterval(apply, 30000);
          apply();
        }
      }

      // Шапка мягко отбрасывает тень, когда страница прокручена.
      const topbar = document.querySelector<HTMLElement>('.topbar');
      if (topbar) {
        const onScroll = () => topbar.classList.toggle('scrolled', window.scrollY > 10);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

    </script>
