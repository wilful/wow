---
// Первая небольшая страница в духе foreverchanges.pro:
// плотная тёмная «игровая» шапка, золотые акценты, засечные заголовки,
// плитки разделов и мягкая фэнтезийная подложка (нарисована на CSS).
const title = 'Сайт находится в разработке';

const nav = [
  { label: 'Патчи', dot: true },
  { label: 'Таланты' },
  { label: 'Сборки', dot: true },
  { label: 'Заклинания' },
  { label: 'Расы' },
  { label: 'Подземелья' },
  { label: 'Предметы' },
  { label: 'Квесты', dot: true },
  { label: 'Карта' },
  { label: 'Гайды' },
];

const tiles = [
  { title: 'Изменения', note: 'скоро' },
  { title: 'Патчи', note: 'скоро' },
  { title: 'Таланты', note: 'скоро' },
  { title: 'Сборки', note: 'скоро' },
  { title: 'Карта', note: 'скоро' },
  { title: 'Гайды', note: 'скоро' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Фан-хаб WoW Forever готовится к запуску: патчи, таланты, карта и гайды." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#08090c" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Alegreya:ital,wght@0,400;0,500;1,400&display=swap"
    />

    <style>
      :root {
        color-scheme: dark;
        --bg: #08090c;
        --panel: rgba(255, 255, 255, 0.035);
        --panel-2: rgba(255, 255, 255, 0.06);
        --line: rgba(206, 172, 92, 0.2);
        --line-soft: rgba(236, 229, 216, 0.09);
        --fg: #efe7d7;
        --muted: #8f8778;
        --gold: #ceac5c;
        --gold-light: #f4e0a8;
        --gold-deep: #7a5f22;
        --epic: #a335ee;
        --font-title: 'Cinzel', 'Palatino Linotype', Georgia, serif;
        --font-body: 'Alegreya', Georgia, 'Times New Roman', serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 16.5px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* фон: туман над горизонтом, арканное свечение и виньетка */
      .scene {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(ellipse 60% 34% at 50% 100%, rgba(206, 172, 92, 0.2), transparent 72%),
          radial-gradient(ellipse 45% 32% at 12% 4%, rgba(163, 53, 238, 0.16), transparent 72%),
          radial-gradient(ellipse 55% 30% at 92% 2%, rgba(74, 139, 232, 0.13), transparent 72%),
          linear-gradient(180deg, #0a0c11 0%, #0c1017 48%, #07080b 100%);
      }

      .scene::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0.5;
        background-image:
          linear-gradient(0deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
        background-size: 46px 46px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 45%, #000 20%, transparent 78%);
      }

      .scene::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 78% 62% at 50% 42%, transparent 40%, rgba(0, 0, 0, 0.62));
      }

      /* силуэт дальних гор и руин */
      .ridge {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 34vh;
        min-height: 190px;
        z-index: -1;
        pointer-events: none;
      }

      .shell {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px 44px;
      }

      /* ── шапка ─────────────────────────────────────────── */
      .site-top {
        position: relative;
        z-index: 3;
        margin: 0 -20px 34px;
        padding: 0 20px;
        background: linear-gradient(180deg, rgba(8, 9, 12, 0.96) 55%, rgba(8, 9, 12, 0.55));
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(8px);
      }

      .masthead {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 16px;
        padding: 14px 0 12px;
        border-bottom: 1px solid var(--line-soft);
      }

      .online {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.84rem;
        color: var(--muted);
      }

      .online-face {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: radial-gradient(circle at 35% 25%, rgba(206, 172, 92, 0.28), rgba(0, 0, 0, 0.4));
        box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.6);
      }

      .online-text b {
        display: block;
        color: var(--fg);
        font-weight: 500;
      }

      .online-text i {
        color: var(--muted);
        font-size: 0.76rem;
        font-style: normal;
      }

      .logo {
        text-align: center;
      }

      .logo-title {
        display: block;
        font-family: var(--font-title);
        font-size: clamp(1.15rem, 3vw, 1.7rem);
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        background: linear-gradient(180deg, var(--gold-light) 10%, var(--gold) 62%, var(--gold-deep));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 0 22px rgba(206, 172, 92, 0.18);
      }

      .logo-sub {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.7rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
      }

      .meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 11px;
        border: 1px solid var(--line-soft);
        border-radius: 3px;
        background: var(--panel);
        color: var(--muted);
        font-size: 0.76rem;
        letter-spacing: 0.03em;
        white-space: nowrap;
      }

      .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 8px currentColor;
      }

      .chip.is-epic {
        color: #c98cf5;
        border-color: rgba(163, 53, 238, 0.4);
      }

      /* ── навигация ─────────────────────────────────────── */
      .p-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 8px 0;
      }

      .p-bar nav {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 4px;
        flex: 1;
      }

      .p-bar nav a {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border: 1px solid transparent;
        border-radius: 3px;
        color: var(--muted);
        font-family: var(--font-title);
        font-size: 0.72rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
      }

      .p-bar nav a:hover,
      .p-bar nav a:focus-visible {
        color: var(--gold-light);
        background: var(--panel);
        border-color: var(--line);
      }

      .p-bar nav a .dot {
        color: var(--gold);
      }

      .nav-tools {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
        font-size: 0.76rem;
      }

      .nav-tools .chip {
        border-style: dashed;
      }

      /* ── полоса статуса ────────────────────────────────── */
      .progress {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 42px;
        padding: 10px 14px;
        border: 1px solid var(--line);
        border-radius: 4px;
        background: linear-gradient(90deg, rgba(206, 172, 92, 0.09), rgba(0, 0, 0, 0) 65%), var(--panel);
      }

      .progress p {
        margin: 0;
        color: var(--fg);
        font-size: 0.86rem;
        white-space: nowrap;
      }

      .progress p b {
        color: var(--gold-light);
        font-weight: 500;
      }

      .progress-bar {
        flex: 1;
        height: 5px;
        border-radius: 99px;
        background: rgba(255, 255, 255, 0.07);
        overflow: hidden;
      }

      .progress-bar span {
        display: block;
        width: 32%;
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, var(--gold-deep), var(--gold-light));
        box-shadow: 0 0 12px rgba(206, 172, 92, 0.4);
      }

      /* ── герой ─────────────────────────────────────────── */
      .hero {
        text-align: center;
        margin-bottom: 52px;
      }

      .hero .eyebrow {
        margin: 0 0 16px;
        color: var(--gold);
        font-family: var(--font-title);
        font-size: 0.72rem;
        letter-spacing: 0.34em;
        text-transform: uppercase;
      }

      .hero h1 {
        margin: 0 auto 20px;
        max-width: 20ch;
        font-family: var(--font-title);
        font-size: clamp(2rem, 6.4vw, 3.7rem);
        font-weight: 600;
        line-height: 1.12;
        text-wrap: balance;
        background: linear-gradient(180deg, #fff8e6 10%, var(--gold) 60%, #8d6f2b);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 18px rgba(0, 0, 0, 0.6));
      }

      .hero .lead {
        margin: 0 auto;
        max-width: 54ch;
        color: #b3aa99;
        font-size: clamp(1rem, 2.1vw, 1.12rem);
      }

      .rule {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin: 30px auto 0;
        max-width: 320px;
        color: var(--gold);
      }

      .rule::before,
      .rule::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--line), transparent);
      }

      /* ── плитки разделов ───────────────────────────────── */
      .tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(178px, 1fr));
        gap: 12px;
        padding: 0;
        margin: 0 0 46px;
        list-style: none;
      }

      .tiles li {
        position: relative;
        padding: 18px 16px;
        border: 1px solid var(--line-soft);
        border-radius: 4px;
        background: linear-gradient(180deg, var(--panel-2), rgba(0, 0, 0, 0.18));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
      }

      .tiles li::after {
        content: '';
        position: absolute;
        inset: 5px;
        border: 1px solid rgba(206, 172, 92, 0.14);
        border-radius: 2px;
        pointer-events: none;
      }

      .tiles h2 {
        margin: 0 0 6px;
        font-family: var(--font-title);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--fg);
      }

      .tiles p {
        margin: 0;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* ── подвал ────────────────────────────────────────── */
      footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 10px 24px;
        padding-top: 20px;
        border-top: 1px solid var(--line-soft);
        color: var(--muted);
        font-size: 0.8rem;
      }

      footer .tip {
        font-style: italic;
      }

      @media (max-width: 860px) {
        .masthead {
          grid-template-columns: 1fr;
          justify-items: center;
          text-align: center;
        }

        .meta {
          justify-content: center;
        }

        .p-bar nav a:nth-child(n + 7) {
          display: none;
        }

        .p-bar {
          flex-direction: column;
          align-items: stretch;
          gap: 6px;
        }
      }

      @media (max-width: 560px) {
        .online-text i,
        .logo-sub {
          display: none;
        }

        .progress p {
          white-space: normal;
        }
      }
    </style>
  </head>
  <body>
    <div class="scene" aria-hidden="true"></div>
    <svg class="ridge" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="far" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#171c26" />
          <stop offset="1" stop-color="#0a0c10" />
        </linearGradient>
        <linearGradient id="near" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0e1219" />
          <stop offset="1" stop-color="#07080b" />
        </linearGradient>
      </defs>
      <path
        fill="url(#far)"
        d="M0 236l92-46 78 30 96-64 88 46 74-28 92 54 84-40 96 30 90-52 96 46 84-30 100 44 88-24 92 40 92-34 96 46v96H0z"
      />
      <path
        fill="url(#near)"
        d="M0 288l108-40 96 26 88-34 104 40 92-26 104 36 96-30 100 38 96-28 108 40 92-26 96 32 84-22 76 26v56H0z"
      />
      <g fill="#0b0e13">
        <path d="M1020 288v-58h10v-16h16v16h10v58z" />
        <path d="M1064 288v-40h8v-12h12v12h8v40z" />
      </g>
    </svg>

    <div class="shell">
      <div class="site-top">
        <div class="masthead">
          <div class="online">
            <span class="online-face" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ceac5c" stroke-width="1.6">
                <path d="M12 3l7 4v6c0 4-3 7-7 8-4-1-7-4-7-8V7z" />
                <path d="M12 8v5" />
              </svg>
            </span>
            <span class="online-text">
              <b>Сайт готовится к запуску</b>
              <i>Разделы откроются по мере готовности</i>
            </span>
          </div>

          <a class="logo" href="/">
            <span class="logo-title">WoW Forever</span>
            <span class="logo-sub">Патчи · Таланты · Карта</span>
          </a>

          <div class="meta">
            <span class="chip is-epic"><span class="dot"></span>В разработке</span>
            <span class="chip"><span class="dot" style="color:#ceac5c"></span>Скоро</span>
          </div>
        </div>

        <div class="p-bar">
          <nav aria-label="Разделы сайта">
            {
              nav.map((item) => (
                <a href="#">
                  {item.dot && <span class="dot" aria-hidden="true" />}
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="nav-tools">
            <span class="chip">Ещё</span>
            <span class="chip">Discord</span>
            <span class="chip">RU</span>
          </div>
        </div>
      </div>

      <div class="progress">
        <p>Статус разработки: <b>готовим первую версию</b></p>
        <span class="progress-bar" aria-hidden="true"><span></span></span>
      </div>

      <main>
        <section class="hero">
          <p class="eyebrow">Скоро открытие</p>
          <h1>Сайт находится в разработке</h1>
          <p class="lead">
            Мы собираем фан-хаб по WoW Forever: изменения, патчи, таланты, карта и гайды в одном
            месте. Эта страница обновится первой.
          </p>
          <p class="rule" aria-hidden="true">✦</p>
        </section>

        <ul class="tiles">
          {tiles.map((tile) => <li><h2>{tile.title}</h2><p>{tile.note}</p></li>)}
        </ul>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} WoW Forever</span>
        <span class="tip">Совет: заходите позже — разделы появятся по одному</span>
      </footer>
    </div>
  </body>
</html>
