---
// Полностью новый дизайн WoW Forever: светлая, современная «база знаний».
// Сохранён только смысл сайта — фан-хаб проекта в стадии запуска.
const title = 'WoW Forever — база знаний проекта';

const nav = [
  { label: 'Патчи' },
  { label: 'Таланты' },
  { label: 'Сборки' },
  { label: 'Подземелья' },
  { label: 'Карта' },
  { label: 'Гайды' },
];

// Разделы хаба: иконка (inline svg), название, описание, статус.
const sections = [
  {
    icon: 'patch',
    title: 'Патчи',
    note: 'Список изменений и обновлений проекта.',
    status: 'скоро',
  },
  {
    icon: 'talent',
    title: 'Таланты',
    note: 'Деревья талантов и советы по прокачке.',
    status: 'скоро',
  },
  {
    icon: 'build',
    title: 'Сборки',
    note: 'Готовые билды для классов и специализаций.',
    status: 'скоро',
  },
  {
    icon: 'spell',
    title: 'Заклинания',
    note: 'Описание умений, кулдаунов и связок.',
    status: 'позже',
  },
  {
    icon: 'race',
    title: 'Расы',
    note: 'Особенности рас, бонусы и стартовые зоны.',
    status: 'позже',
  },
  {
    icon: 'dungeon',
    title: 'Подземелья',
    note: 'Карты, боссы и тактики прохождения.',
    status: 'скоро',
  },
  {
    icon: 'item',
    title: 'Предметы',
    note: 'Лут, рецепты и where-to-get справочник.',
    status: 'позже',
  },
  {
    icon: 'quest',
    title: 'Квесты',
    note: 'Цепочки заданий и награды за прохождение.',
    status: 'скоро',
  },
  {
    icon: 'map',
    title: 'Карта',
    note: 'Интерактивная карта мира и локаций.',
    status: 'скоро',
  },
  {
    icon: 'guide',
    title: 'Гайды',
    note: 'Пошаговые руководства от сообщества.',
    status: 'скоро',
  },
];

// Этапы подготовки к запуску.
const steps = [
  { label: 'Концепт', done: true },
  { label: 'Дизайн', done: true },
  { label: 'Контент', done: false, active: true },
  { label: 'Запуск', done: false },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="WoW Forever — фан-хаб проекта: патчи, таланты, сборки, подземелья, карта и гайды в одном месте. Открытие скоро." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#eef1f6" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
    />

    <style>
      :root {
        color-scheme: light;
        --bg: #eef1f6;
        --bg-2: #e3e8f2;
        --surface: #ffffff;
        --surface-2: #f7f9fc;
        --ink: #161d2b;
        --muted: #6a7384;
        --line: rgba(22, 29, 43, 0.1);
        --line-strong: rgba(22, 29, 43, 0.16);
        --blue: #3a5bd9;
        --blue-deep: #263e9e;
        --teal: #0fb5a6;
        --violet: #7c5cff;
        --coral: #ff6b5e;
        --shadow: 0 18px 40px -22px rgba(22, 29, 43, 0.45);
        --shadow-sm: 0 8px 20px -14px rgba(22, 29, 43, 0.4);
        --radius: 18px;
        --radius-sm: 12px;
        --font-title: 'Space Grotesk', 'Segoe UI', system-ui, sans-serif;
        --font-body: 'Inter', 'Segoe UI', system-ui, sans-serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100svh;
        background:
          radial-gradient(60% 50% at 85% -5%, rgba(124, 92, 255, 0.16), transparent 60%),
          radial-gradient(55% 45% at 5% 0%, rgba(15, 181, 166, 0.14), transparent 55%),
          linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .shell {
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 22px;
      }

      /* ── навигация ───────────────────────────────────── */
      .nav {
        position: sticky;
        top: 14px;
        z-index: 20;
        margin: 14px auto 0;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 12px 18px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid var(--line);
        border-radius: 999px;
        backdrop-filter: blur(14px);
        box-shadow: var(--shadow-sm);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        font-family: var(--font-title);
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .brand .mark {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--blue), var(--violet));
        box-shadow: 0 6px 14px -6px var(--blue);
      }

      .brand b {
        font-size: 1.02rem;
      }

      .brand span {
        color: var(--muted);
        font-weight: 500;
        font-size: 0.8rem;
      }

      .nav-links {
        display: flex;
        gap: 4px;
        margin-left: auto;
        flex-wrap: wrap;
      }

      .nav-links a {
        padding: 8px 14px;
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.16s ease, background 0.16s ease;
      }

      .nav-links a:hover {
        color: var(--blue-deep);
        background: rgba(58, 91, 217, 0.08);
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
      }

      .pill.status {
        color: var(--blue-deep);
        background: rgba(58, 91, 217, 0.12);
        border: 1px solid rgba(58, 91, 217, 0.25);
      }

      .pill .blink {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--blue);
        box-shadow: 0 0 0 0 rgba(58, 91, 217, 0.5);
        animation: pulse 1.8s infinite;
      }

      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(58, 91, 217, 0.5); }
        70% { box-shadow: 0 0 0 8px rgba(58, 91, 217, 0); }
        100% { box-shadow: 0 0 0 0 rgba(58, 91, 217, 0); }
      }

      /* ── герой ───────────────────────────────────────── */
      .hero {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 40px;
        align-items: center;
        padding: 64px 0 40px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 18px;
        padding: 6px 12px;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--line);
        color: var(--teal);
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.02em;
      }

      .hero h1 {
        margin: 0 0 18px;
        font-family: var(--font-title);
        font-size: clamp(2.3rem, 5.6vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }

      .hero h1 .grad {
        background: linear-gradient(120deg, var(--blue), var(--violet) 55%, var(--teal));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .hero p.lead {
        margin: 0 0 26px;
        max-width: 46ch;
        color: var(--muted);
        font-size: 1.06rem;
      }

      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: transform 0.14s ease, box-shadow 0.14s ease;
      }

      .btn:active {
        transform: translateY(1px);
      }

      .btn.primary {
        color: #fff;
        background: linear-gradient(135deg, var(--blue), var(--blue-deep));
        box-shadow: 0 12px 26px -12px var(--blue);
      }

      .btn.ghost {
        color: var(--ink);
        background: var(--surface);
        border: 1px solid var(--line-strong);
      }

      .hero-stats {
        display: flex;
        gap: 26px;
        margin-top: 34px;
        padding-top: 26px;
        border-top: 1px solid var(--line);
      }

      .hero-stats .num {
        font-family: var(--font-title);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
      }

      .hero-stats .cap {
        font-size: 0.82rem;
        color: var(--muted);
      }

      /* ── иллюстрация справа ──────────────────────────── */
      .visual {
        position: relative;
        aspect-ratio: 1 / 1;
        border-radius: 26px;
        background:
          radial-gradient(70% 70% at 30% 25%, rgba(124, 92, 255, 0.22), transparent 60%),
          radial-gradient(60% 60% at 80% 80%, rgba(15, 181, 166, 0.2), transparent 60%),
          linear-gradient(160deg, #ffffff, #eef1f8);
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .visual .ring {
        position: absolute;
        inset: 12% ;
        border-radius: 50%;
        border: 1px dashed rgba(58, 91, 217, 0.28);
        animation: spin 26s linear infinite;
      }

      .visual .ring.two {
        inset: 26%;
        border-color: rgba(15, 181, 166, 0.32);
        animation-duration: 34s;
        animation-direction: reverse;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      .visual .core {
        position: absolute;
        inset: 0;
        margin: auto;
        width: 38%;
        height: 38%;
        border-radius: 22px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, var(--blue), var(--violet));
        box-shadow: 0 18px 40px -14px var(--blue);
        color: #fff;
      }

      .visual .chiplet {
        position: absolute;
        padding: 8px 12px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid var(--line);
        font-size: 0.78rem;
        font-weight: 600;
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(6px);
      }

      .visual .c1 { top: 14%; left: 10%; color: var(--blue-deep); }
      .visual .c2 { top: 24%; right: 8%; color: var(--teal); }
      .visual .c3 { bottom: 16%; left: 14%; color: var(--violet); }
      .visual .c4 { bottom: 22%; right: 12%; color: var(--coral); }

      /* ── секции хаба ─────────────────────────────────── */
      .section-head {
        text-align: center;
        margin: 30px auto 30px;
        max-width: 56ch;
      }

      .section-head .tag {
        color: var(--blue);
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .section-head h2 {
        margin: 8px 0 10px;
        font-family: var(--font-title);
        font-size: clamp(1.6rem, 3.6vw, 2.3rem);
        letter-spacing: -0.02em;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(248px, 1fr));
        gap: 16px;
        margin: 0 0 56px;
        padding: 0;
        list-style: none;
      }

      .card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
        border-radius: var(--radius);
        background: var(--surface);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-sm);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow);
        border-color: rgba(58, 91, 217, 0.4);
      }

      .card .ico {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(58, 91, 217, 0.14), rgba(124, 92, 255, 0.14));
        color: var(--blue-deep);
      }

      .card h3 {
        margin: 2px 0 0;
        font-family: var(--font-title);
        font-size: 1.05rem;
        font-weight: 600;
      }

      .card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
        flex: 1;
      }

      .card .soon {
        align-self: flex-start;
        margin-top: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 600;
        color: var(--muted);
        background: var(--surface-2);
        border: 1px solid var(--line);
      }

      .card .soon.hot {
        color: var(--coral);
        background: rgba(255, 107, 94, 0.1);
        border-color: rgba(255, 107, 94, 0.3);
      }

      /* ── дорожная карта ─────────────────────────────── */
      .roadmap {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin: 0 0 60px;
        padding: 26px;
        border-radius: var(--radius);
        background: var(--surface);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-sm);
      }

      .step {
        position: relative;
        padding-left: 34px;
      }

      .step::before {
        content: '';
        position: absolute;
        left: 7px;
        top: 6px;
        bottom: -26px;
        width: 2px;
        background: var(--line);
      }

      .step:last-child::before {
        display: none;
      }

      .step .dot {
        position: absolute;
        left: 0;
        top: 2px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--surface);
        border: 2px solid var(--line-strong);
      }

      .step.done .dot {
        background: var(--teal);
        border-color: var(--teal);
      }

      .step.active .dot {
        background: var(--blue);
        border-color: var(--blue);
        box-shadow: 0 0 0 4px rgba(58, 91, 217, 0.18);
      }

      .step .lbl {
        font-family: var(--font-title);
        font-weight: 600;
        font-size: 0.98rem;
      }

      .step .sub {
        font-size: 0.8rem;
        color: var(--muted);
      }

      /* ── подвал ─────────────────────────────────────── */
      footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 14px;
        padding: 26px 0 48px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.88rem;
      }

      footer .links {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }

      footer .links a:hover {
        color: var(--blue-deep);
      }

      @media (max-width: 880px) {
        .hero {
          grid-template-columns: 1fr;
          padding-top: 40px;
        }
        .visual {
          order: -1;
          max-width: 380px;
          margin: 0 auto;
          width: 100%;
        }
        .nav-links {
          display: none;
        }
        .roadmap {
          grid-template-columns: repeat(2, 1fr);
        }
        .step:nth-child(2)::before {
          display: none;
        }
      }

      @media (max-width: 520px) {
        .hero-stats {
          gap: 18px;
        }
        .roadmap {
          grid-template-columns: 1fr;
        }
        .step::before {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="nav">
        <a class="brand" href="/">
          <span class="mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8">
              <circle cx="12" cy="12" r="8" />
              <path d="M12 4v16M4 12h16" />
            </svg>
          </span>
          <b>WoW Forever</b>
          <span>фан-хаб</span>
        </a>
        <nav class="nav-links" aria-label="Разделы сайта">
          {
            nav.map((item) => (
              <a href="#">{item.label}</a>
            ))
          }
        </nav>
        <span class="pill status"><span class="blink" aria-hidden="true"></span>В разработке</span>
      </header>

      <main>
        <section class="hero">
          <div class="hero-copy">
            <span class="eyebrow">Открытие скоро</span>
            <h1>База знаний <span class="grad">WoW Forever</span></h1>
            <p class="lead">
              Один адрес для всего проекта: патчи, таланты, сборки, подземелья, карта мира и
              гайды от сообщества. Собираем всё в одном месте — без воды.
            </p>
            <div class="cta">
              <a class="btn primary" href="#sections">Смотреть разделы</a>
              <a class="btn ghost" href="#">Наш Discord</a>
            </div>
            <div class="hero-stats">
              <div>
                <div class="num">10</div>
                <div class="cap">разделов хаба</div>
              </div>
              <div>
                <div class="num">RU</div>
                <div class="cap">язык сообщества</div>
              </div>
              <div>
                <div class="num">2026</div>
                <div class="cap">год запуска</div>
              </div>
            </div>
          </div>

          <div class="visual" aria-hidden="true">
            <div class="ring"></div>
            <div class="ring two"></div>
            <div class="core">
              <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6">
                <path d="M12 2l2.4 6.6L21 9.2l-5 4.6 1.4 6.9L12 17.6 6.6 20.7 8 13.8 3 9.2l6.6-.6z" />
              </svg>
            </div>
            <span class="chiplet c1">Патчи</span>
            <span class="chiplet c2">Таланты</span>
            <span class="chiplet c3">Карта</span>
            <span class="chiplet c4">Гайды</span>
          </div>
        </section>

        <div class="section-head" id="sections">
          <span class="tag">Что внутри</span>
          <h2>Разделы, которые мы готовим</h2>
          <p>Каждый блок откроется по мере наполнения контентом. Следите за статусом.</p>
        </div>

        <ul class="grid">
          {
            sections.map((s) => (
              <li class="card">
                <span class="ico" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    {s.icon === 'patch' && <><path d="M4 12a8 8 0 1 1 8 8" /><path d="M12 8v4l3 2" /></>}
                    {s.icon === 'talent' && <><circle cx="12" cy="5" r="2" /><circle cx="6" cy="15" r="2" /><circle cx="18" cy="15" r="2" /><path d="M12 7v4M12 11l-5 3M12 11l5 3" /></>}
                    {s.icon === 'build' && <><path d="M4 7h16M4 12h10M4 17h7" /><circle cx="18" cy="14" r="3" /></>}
                    {s.icon === 'spell' && <><path d="M12 3v4M12 17v4M3 12h4M17 12h4" /><circle cx="12" cy="12" r="3" /></>}
                    {s.icon === 'race' && <><circle cx="12" cy="7" r="3" /><path d="M6 21v-4a6 6 0 0 1 12 0v4" /></>}
                    {s.icon === 'dungeon' && <><path d="M4 21V8l8-4 8 4v13" /><path d="M9 21v-6h6v6" /></>}
                    {s.icon === 'item' && <><path d="M12 3l3 5-3 2-3-2z" /><path d="M12 10v11" /></>}
                    {s.icon === 'quest' && <><path d="M9 4h6v4a3 3 0 0 1-6 0z" /><path d="M12 11v9" /><circle cx="12" cy="16" r="1.4" /></>}
                    {s.icon === 'map' && <><path d="M9 4 4 6v14l5-2 6 2 5-2V4l-5 2-6-2z" /><path d="M9 4v14M15 6v14" /></>}
                    {s.icon === 'guide' && <><path d="M6 3h9l3 3v15l-3-2H6z" /><path d="M9 8h6M9 12h6" /></>}
                  </svg>
                </span>
                <h3>{s.title}</h3>
                <p>{s.note}</p>
                <span class={`soon${s.status === 'скоро' ? ' hot' : ''}`}>{s.status}</span>
              </li>
            ))
          }
        </ul>

        <div class="section-head">
          <span class="tag">Дорожная карта</span>
          <h2>Как идёт подготовка</h2>
        </div>
        <div class="roadmap">
          {
            steps.map((st) => (
              <div class={`step${st.done ? ' done' : ''}${st.active ? ' active' : ''}`}>
                <span class="dot" aria-hidden="true" />
                <div class="lbl">{st.label}</div>
                <div class="sub">{st.done ? 'готово' : st.active ? 'в работе' : 'впереди'}</div>
              </div>
            ))
          }
        </div>
      </main>

