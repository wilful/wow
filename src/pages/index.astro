---
// Первая небольшая страница в духе фан-хаба WoW Forever:
// тёмный фон, крупный засечный заголовок, золотые акценты, верхняя навигация.
const title = 'Сайт находится в разработке';
const nav = [
  { label: 'Патчи', href: '#' },
  { label: 'Таланты', href: '#' },
  { label: 'Карта', href: '#' },
  { label: 'Гайды', href: '#' },
];
const statuses = ['Обновления появятся здесь', 'Заходите чуть позже'];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Фан-хаб WoW Forever готовится к запуску. Совсем скоро." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0c11" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Alegreya:ital,wght@0,400;0,500;1,400&display=swap"
    />

    <style>
      :root {
        color-scheme: dark;
        --bg: #0a0c11;
        --bg-soft: #12161d;
        --panel: rgba(255, 255, 255, 0.04);
        --line: rgba(216, 180, 90, 0.22);
        --fg: #ece5d8;
        --muted: #948c7d;
        --gold: #d8b45a;
        --gold-light: #f2dda6;
        --epic: #a335ee;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--fg);
        font-family: 'Alegreya', Georgia, 'Times New Roman', serif;
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* ночное небо, дальнее свечение и мягкая виньетка */
      .backdrop {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;
        background:
          radial-gradient(ellipse 70% 45% at 50% 108%, rgba(216, 180, 90, 0.22), transparent 70%),
          radial-gradient(ellipse 50% 40% at 18% 8%, rgba(163, 53, 238, 0.14), transparent 70%),
          radial-gradient(ellipse 60% 45% at 88% 0%, rgba(74, 139, 232, 0.12), transparent 70%),
          linear-gradient(180deg, #0a0c11 0%, #0d1119 55%, #080a0e 100%);
      }

      .backdrop::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 40%, transparent 45%, rgba(0, 0, 0, 0.55));
      }

      .shell {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 22px 40px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      /* верхняя навигация */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 16px 0;
        background: linear-gradient(180deg, rgba(10, 12, 17, 0.92), rgba(10, 12, 17, 0.4));
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(216, 180, 90, 0.16);
      }

      .wordmark {
        font-family: 'Cinzel', Georgia, serif;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
        background: linear-gradient(180deg, var(--gold-light), var(--gold));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        margin-left: auto;
      }

      nav a {
        color: var(--muted);
        font-family: 'Cinzel', Georgia, serif;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 4px 2px;
        border-bottom: 1px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
      }

      nav a:hover,
      nav a:focus-visible {
        color: var(--gold-light);
        border-color: var(--line);
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 13px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--panel);
        color: var(--muted);
        font-size: 0.78rem;
        white-space: nowrap;
      }

      .pill::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--epic);
        box-shadow: 0 0 0 4px rgba(163, 53, 238, 0.16);
      }

      /* герой */
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: clamp(48px, 12vh, 120px) 0;
      }

      .eyebrow {
        margin: 0 0 20px;
        color: var(--gold);
        font-family: 'Cinzel', Georgia, serif;
        font-size: 0.74rem;
        letter-spacing: 0.32em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 24px;
        max-width: 18ch;
        font-family: 'Cinzel', Georgia, serif;
        font-size: clamp(2.1rem, 7vw, 4rem);
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: 0.01em;
        text-wrap: balance;
        background: linear-gradient(180deg, #fff6df 12%, var(--gold) 88%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        margin: 0 0 34px;
        max-width: 52ch;
        color: var(--muted);
        font-size: clamp(1rem, 2.2vw, 1.15rem);
      }

      .statuses {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .statuses li {
        padding: 7px 15px;
        border: 1px solid rgba(236, 229, 216, 0.1);
        border-radius: 999px;
        background: var(--panel);
        color: var(--muted);
        font-size: 0.82rem;
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 20px;
        padding-top: 20px;
        border-top: 1px solid rgba(216, 180, 90, 0.14);
        color: var(--muted);
        font-size: 0.8rem;
      }

      @media (max-width: 640px) {
        nav {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>

    <div class="shell">
      <header class="topbar">
        <span class="wordmark">WoW Forever</span>
        <nav aria-label="Разделы сайта">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <span class="pill">Сайт в разработке</span>
      </header>

      <main>
        <p class="eyebrow">Скоро</p>
        <h1>Сайт находится в разработке</h1>
        <p class="lead">
          Мы собираем фан-хаб: изменения, патчи и гайды в одном месте. Совсем скоро всё
          откроется — эта страница обновится первой.
        </p>
        <ul class="statuses">
          {statuses.map((label) => <li>{label}</li>)}
        </ul>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} WoW Forever</span>
        <span>Готовим первую версию</span>
      </footer>
    </div>
  </body>
</html>
